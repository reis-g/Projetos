import React, { useEffect, useState } from 'react';
import { ScrollView, Image, Text, View, StyleSheet, TouchableOpacity } from 'react-native';
import { Audio } from 'expo-av';
import { initializeApp } from 'firebase/app';
import { getFirestore, collection, getDocs } from 'firebase/firestore';
import { NavigationContainer } from '@react-navigation/native';
import { createNativeStackNavigator } from '@react-navigation/native-stack';
import { Button } from 'react-native-paper';

const firebaseConfig = {
    "project_info": {
      "project_number": "1012928568255",
      "project_id": "hitorinhasapp",
      "storage_bucket": "hitorinhasapp.firebasestorage.app"
    },
    "client": [
      {
        "client_info": {
          "mobilesdk_app_id": "1:1012928568255:android:d4de49f797f1ca9dcf9f0a",
          "android_client_info": {
            "package_name": "com.reis.apphistorias"
          }
        },
        "oauth_client": [
          {
            "client_id": "1012928568255-n4l1fsdt04ihog520anls1oudki41mjc.apps.googleusercontent.com",
            "client_type": 3
          }
        ],
        "api_key": [
          {
            "current_key": "AIzaSyDTQQSBYHF5Qdz-czJiHWoFvTH7TA66kCM"
          }
        ],
        "services": {
          "appinvite_service": {
            "other_platform_oauth_client": [
              {
                "client_id": "1012928568255-n4l1fsdt04ihog520anls1oudki41mjc.apps.googleusercontent.com",
                "client_type": 3
              }
            ]
          }
        }
      }
    ],
    "configuration_version": "1"
  }

const app = initializeApp(firebaseConfig);
const db = getFirestore(app);

const Stack = createNativeStackNavigator();

function CatalogScreen({ navigation }) {
  const [historias, setHistorias] = useState([]);

  useEffect(() => {
    async function carregarHistorias() {
      const querySnapshot = await getDocs(collection(db, 'historias'));
      const dados = querySnapshot.docs.map(doc => ({ id: doc.id, ...doc.data() }));
      setHistorias(dados);
    }
    carregarHistorias();
  }, []);

  return (
    <ScrollView contentContainerStyle={styles.catalogoContainer}>
      {historias.map(historia => (
        <TouchableOpacity key={historia.id} style={styles.card} onPress={() => navigation.navigate('História', { historia })}>
          <Image source={{ uri: historia.imagemURL }} style={styles.miniatura} />
          <Text style={styles.titulo}>{historia.titulo}</Text>
        </TouchableOpacity>
      ))}
    </ScrollView>
  );
}

function HistoriaScreen({ route }) {
  const { historia } = route.params;
  const [sound, setSound] = useState();

  async function tocarAudio() {
    if (sound) {
      await sound.replayAsync();
    } else {
      const { sound: novoSom } = await Audio.Sound.createAsync({ uri: historia.audioURL });
      setSound(novoSom);
      await novoSom.playAsync();
    }
  }

  useEffect(() => {
    return sound ? () => sound.unloadAsync() : undefined;
  }, [sound]);

  return (
    <View style={styles.historiaContainer}>
      <Image source={{ uri: historia.imagemURL }} style={styles.imagemGrande} />
      <ScrollView style={styles.textoContainer}>
        <Text style={styles.texto}>{historia.texto}</Text>
      </ScrollView>
      <Button icon="volume-high" mode="contained" onPress={tocarAudio}>
        Ouvir história
      </Button>
    </View>
  );
}

export default function App() {
  return (
    <NavigationContainer>
      <Stack.Navigator>
        <Stack.Screen name="Catálogo" component={CatalogScreen} />
        <Stack.Screen name="História" component={HistoriaScreen} />
      </Stack.Navigator>
    </NavigationContainer>
  );
}

const styles = StyleSheet.create({
  catalogoContainer: {
    padding: 10,
    flexDirection: 'column',
    alignItems: 'center'
  },
  card: {
    flexDirection: 'row',
    alignItems: 'center',
