  },
  titulo: {
    fontSize: 18,
    fontWeight: 'bold'
  },
  historiaContainer: {
    flex: 1,
    padding: 10
  },
  imagemGrande: {
    width: '100%',
    height: 200,
    resizeMode: 'cover',
    marginBottom: 10,
    borderRadius: 10
  },
  textoContainer: {
    flex: 1,
    marginBottom: 10
  },
  texto: {
    fontSize: 16
  }
});
